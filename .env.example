# Copy to .env and fill in. Never commit real secrets.
#   cp .env.example .env

# --- required ---
# Bearer token for POST /v1/search, /v1/fetch, /v1/x_search
WEBGATE_TOKEN=

# --- Cloak / CDP (same values for webgate fetch and SearXNG Google engine) ---
# CDP URL of an *already launched* Cloak profile. From the compose network:
#   http://cloak-manager:8080/api/profiles/<id>/cdp
# (host UI is http://127.0.0.1:8081 — do not use that as CDP_ENDPOINT for containers)
# or a ws://…/devtools/browser/... endpoint. Compose cannot invent this.
CDP_ENDPOINT=
# Optional Bearer for the CDP HTTP endpoint
CDP_API_KEY=
# Set to 1 to disable Cloak fetch (returns cloak_disabled). Search still works.
WEBGATE_CLOAK_DISABLED=
# Debug/try page at GET /debug (default on). Set to 0 to disable (404).
WEBGATE_DEBUG_UI=
# Manager UI/API token (required with compose.cloak.yaml --profile cloak)
CLOAK_AUTH_TOKEN=

# --- SearXNG ---
# Inside compose, webgate defaults to http://searxng:8080 (internal DNS).
# For an external SearXNG, set this and start only webgate (see README).
SEARXNG_BASE_URL=
# Base URL advertised inside the SearXNG container (trailing slash).
SEARXNG_PUBLIC_BASE_URL=http://searxng:8080/

# --- optional OpenAI / xAI (Responses-compatible; secrets stay in env) ---
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
XAI_BASE_URL=
XAI_API_KEY=
XAI_MODEL=

# --- optional SearXNG Google CDP proxy knobs (empty = image defaults) ---
MIN_INTERVAL_MS=
MAX_PAGE=
GOTO_TIMEOUT_MS=
WAIT_SELECTOR_TIMEOUT_MS=
CAPTCHA_RETRIES=
FAILURE_CACHE_S=
GOOGLE_HL=
GOOGLE_GL=
GOOGLE_UDM=
GOOGLE_SAFE=
GOOGLE_PWS=
GOOGLE_AS_EQ=
